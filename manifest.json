{
    "manifest_version": 3,
    "name": "LnkJump",
    "version": "1.0.0",
    "description": "Short links (tr.ee, bit.ly, t.co, lnkd.in, etc.) -> direct URLs. Auto-redirect + hover popup + context menu.",
    "permissions": [
        "storage",
        "tabs",
        "webNavigation",
        "contextMenus",
        "clipboardWrite",
        "notifications"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "LnkJump",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "128": "icons/128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_ui": {
        "page": "popup.html",
        "open_in_tab": false
    }
}